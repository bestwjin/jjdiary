# 현재 Worker/로컬이 쓰는 DB 연결 문자열
# Supabase 서울(ap-northeast-2) Session pooler(5432) 권장 — Direct(db.*)는 IPv6-only인 경우가 많음
# postgresql://postgres.[ref]:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# (전환용) Direct / Pooler 원본
# SUPABASE_DATABASE_URL=
# SUPABASE_POOLER_URL=

# 공휴일 인증키는 설정 화면에서 DB(app_settings)로 관리합니다.
# (선택) 예전 wrangler secret이 있으면 DB 값이 비어 있을 때 fallback으로 쓰입니다.
# wrangler secret put KASI_SERVICE_KEY
KASI_SERVICE_KEY=
